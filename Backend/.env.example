# ============================================================
# GBI PLC Backend - Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# Server
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gbiplc?schema=public

# JWT (gunakan HS256 agar sederhana; token hanya divalidasi oleh backend)
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Password Reset (jika memakai service email, isi SMTP di bawah)
# Jika tidak ada SMTP, token reset disimpan di tabel password_reset_tokens
# dan endpoint /api/reset-password menerima { email, token, password }.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@philadelphialifecenter.com
MAIL_FROM_NAME="GBI Philadelpia Life Center"

# Bible/Reading (alkitab.mobi + SABDA.org audio)
# Cache HTML passage selama 7 hari (in-memory)
BIBLE_CACHE_TTL_DAYS=7
