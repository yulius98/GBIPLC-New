# ============================================================
# GBI PLC Backend - Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# Server
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000

# URL yang dipakai untuk link reset password di email (frontend SPA).
# Dev: http://localhost:5173 (Vite). Produksi: domain publik frontend.
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gbiplc?schema=public

# JWT (gunakan HS256 agar sederhana; token hanya divalidasi oleh backend)
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Password Reset (kirim link melalui SMTP; MAIL_ENABLED=true untuk mengaktifkan)
# Jika MAIL_ENABLED=false, link reset hanya dicetak ke console backend (mode development).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=gbiplcbabarsari@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=gbiplcbabarsari@gmail.com
MAIL_FROM_NAME="GBI Philadelpia Life Center"

# Bible/Reading (alkitab.mobi + SABDA.org audio)
# Cache HTML passage selama 7 hari (in-memory)
BIBLE_CACHE_TTL_DAYS=7
