# ============================================================
# GBI PLC - Konfigurasi Docker Compose (root)
# Salin file ini menjadi .env lalu sesuai nilainya.
# Docker Compose otomatis membaca .env di folder root ini
# untuk interpolasi variabel di docker-compose.yml.
# ============================================================

# PostgreSQL (container db). Ganti password di produksi!
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gbiplc

# Cloudflare Tunnel
# Catatan migrasi: sebelumnya token ini dibaca dari Backend/.env lewat
# env_file cloudflared. Itu membocorkan semua secret backend ke container
# tunnel. Sekarang token WAJIB di sini — compose menolak start bila kosong.
CLOUDFLARE_TUNNEL_TOKEN=
